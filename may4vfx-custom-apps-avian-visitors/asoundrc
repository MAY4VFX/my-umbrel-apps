# Микрофон читают одновременно запись и Icecast-стрим, а hw: пускает
# только одного читателя — поэтому доступ шарится через dsnoop.
# Карта адресуется по имени (KT USB Audio), а не по индексу: индекс
# съезжает после перезагрузки или перетыкания USB.
pcm.usb_mic_raw {
    type dsnoop
    ipc_key 1234
    slave {
        pcm "hw:CARD=Audio,DEV=0"
    }
}

# Петличка отдаёт очень тихий сигнал (пик около -40 dBFS), а аппаратное
# усиление карты уже стоит на максимуме (0 dB). Поднимаем вчетверо, то есть
# на +12 дБ: без этого уверенность BirdNET не дотягивает до порога 0.7 и
# распознанные птицы не попадают в базу.
pcm.usb_mic_boost {
    type route
    slave.pcm "usb_mic_raw"
    ttable.0.0 4.0
}

pcm.usb_mic {
    type plug
    slave.pcm "usb_mic_boost"
}
